# PostgreSQL credentials for local Docker Compose runs
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Spring application database access
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/distributed_job_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

# Kafka connection settings
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_DEFAULT_TOPIC=job.requests
KAFKA_CONSUMER_GROUP=worker-group
